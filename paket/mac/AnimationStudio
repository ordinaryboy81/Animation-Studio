#!/bin/bash
# Animation Studio - macOS launcher (the executable inside "Animation Studio.app")
R="$(cd "$(dirname "$0")/../Resources/uygulama" && pwd)"
H="$HOME/AnimationStudio"
mkdir -p "$H"
# Install or update the program files (projects, voices and settings are never touched)
# The studio updates itself from GitHub, so copy only when the app bundle is NEWER than the installed copy
yeni_mi() {  # yeni_mi A B -> true if version A > version B (e.g. 1.10.0 > 1.9.2)
  local IFS=.; local a=($1) b=($2) i
  for i in 0 1 2; do
    [ "${a[i]:-0}" -gt "${b[i]:-0}" ] 2>/dev/null && return 0
    [ "${a[i]:-0}" -lt "${b[i]:-0}" ] 2>/dev/null && return 1
  done; return 1
}
KURULU="$(cat "$H/.surum" 2>/dev/null | tr -d '[:space:]')"; PAKET="$(cat "$R/.surum" | tr -d '[:space:]')"
if [ ! -f "$H/arayuz.py" ] || [ -z "$KURULU" ] || yeni_mi "$PAKET" "$KURULU"; then
  for f in "$R"/* "$R/.surum"; do
    n="$(basename "$f")"
    case "$n" in projeler|tts) continue ;; esac
    rm -rf "$H/$n" && cp -R "$f" "$H/$n"
  done
  mkdir -p "$H/projeler" "$H/tts"
  xattr -dr com.apple.quarantine "$H" 2>/dev/null
  chmod +x "$H/kurulum.command"
fi
# First start or a missing package: run the setup in a visible Terminal window
TARAYICI_YOK=0
if [ ! -d "/Applications/Google Chrome.app" ] && [ ! -d "/Applications/Microsoft Edge.app" ] && [ ! -f "$H/.ortam/.chromium_tamam" ]; then TARAYICI_YOK=1; fi
if [ "$TARAYICI_YOK" = 1 ] || [ ! -x "$H/.ortam/bin/python" ] || ! "$H/.ortam/bin/python" -c "import yaml, PIL, numpy, playwright, uv, ffmpeg" 2>/dev/null; then
  open -a Terminal "$H/kurulum.command"
  exit 0
fi
# Already running: just show it in the browser
if /usr/bin/curl -s -m 2 http://127.0.0.1:8765/api/projeler >/dev/null 2>&1; then
  open "http://127.0.0.1:8765"; exit 0
fi
export PATH="$H/.bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export UV_PYTHON_INSTALL_DIR="$H/.python" UV_CACHE_DIR="$H/.uv_cache" PYTHONUTF8=1
mkdir -p "$H/veri"
cd "$H" && nohup "$H/.ortam/bin/python" arayuz.py > "$H/veri/studyo.log" 2>&1 &
exit 0
